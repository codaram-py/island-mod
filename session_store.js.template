(function(){
var SK=`islandSessions`,CK=`islandSessionCur`,MX=40,CAP=120,DEB=1500;
function rd(){try{var v=JSON.parse(localStorage.getItem(SK)||`[]`);return Array.isArray(v)?v.filter(function(x){return x&&x.id&&Array.isArray(x.messages)}):[]}catch(e){return[]}}
function wr(l){try{localStorage.setItem(SK,JSON.stringify(l.slice(0,MX)))}catch(e){}}
function getCur(){try{return localStorage.getItem(CK)||null}catch(e){return null}}
function setCur(v){try{v?localStorage.setItem(CK,v):localStorage.removeItem(CK)}catch(e){}}
function nid(){return Date.now().toString(36)+Math.random().toString(36).slice(2,8)}
function txt(m){return String(m&&m.text||``)}
function live(ms){return(ms||[]).filter(function(m){return m&&!m.error&&(txt(m).trim()||m.attachments&&m.attachments.length)}).slice(-CAP)}
function names(m){return(m.attachments||[]).map(function(a){return String(a&&a.name||`file`)}).join(`, `)}
function strip(ms){return ms.map(function(m){
var o={id:m.id||nid(),role:m.role===`user`?`user`:`assistant`,text:txt(m)};
if(m.attachments&&m.attachments.length){o.att=m.attachments.length;if(!o.text.trim())o.text=names(m)}
return o})}
function mktitle(ms){
for(var i=0;i<ms.length;i++)if(ms[i].role===`user`){
var t=txt(ms[i]).replace(/\s+/g,` `).trim();
if(t)return t.length>40?t.slice(0,40).replace(/\s\S*$/,``)+`…`:t}
return ``}
function when(at){var d=new Date(at);
try{return d.toLocaleDateString(void 0,{day:`numeric`,month:`short`})+` `+d.toLocaleTimeString(void 0,{hour:`2-digit`,minute:`2-digit`})}
catch(e){return d.toISOString().slice(0,16).replace(`T`,` `)}}
var sig=``,tmr=0;
function save(ms){
var k=live(ms);if(k.length===0)return null;
var s=strip(k),l=rd(),id=getCur()||nid(),i=-1,j;
for(j=0;j<l.length;j++)if(l[j].id===id){i=j;break}
var r={id:id,at:Date.now(),n:s.length,messages:s,title:mktitle(s)};
if(i>=0){if(l[i].renamed){r.title=l[i].title;r.renamed=!0}l.splice(i,1)}
l.unshift(r);wr(l);setCur(id);return id}
function list(){return rd().map(function(x){return{id:x.id,title:x.title||``,at:x.at||0,n:x.n||x.messages.length,when:when(x.at||0),renamed:!!x.renamed}})}
function find(id){var l=rd();for(var i=0;i<l.length;i++)if(l[i].id===id)return l[i];return null}
function open(id){
var r=find(id);if(!r)return null;
save(M.getState().messages);
var ms=strip(r.messages).map(function(m){return{id:m.id,role:m.role,text:m.text}});
setCur(id);sig=``;
M.getState().load().then(function(){
M.setState({messages:ms,streaming:!1,pending:[],notice:null});
try{n.chatSet(JSON.stringify(ms)).catch(function(){})}catch(e){}});
return r}
function del(id){
var l=rd(),o=[],i;
for(i=0;i<l.length;i++)if(l[i].id!==id)o.push(l[i]);
wr(o);if(getCur()===id)setCur(null);return o.length!==l.length}
function rename(id,t){
var l=rd(),i;
for(i=0;i<l.length;i++)if(l[i].id===id){l[i].title=String(t||``).replace(/\s+/g,` `).trim().slice(0,80);l[i].renamed=!0;wr(l);return!0}
return!1}
function auto(){
var st=M.getState();if(st.streaming)return;
var k=live(st.messages);if(k.length===0)return;
var s=k.length+`|`+k[k.length-1].id+`|`+txt(k[k.length-1]).length;
if(s===sig)return;sig=s;save(st.messages)}
function sched(){clearTimeout(tmr);tmr=setTimeout(auto,DEB)}
var orig=M.getState().reset;
M.setState({reset:function(){save(M.getState().messages);setCur(null);sig=``;return orig()}});
M.subscribe(sched);
try{window.addEventListener(`beforeunload`,auto)}catch(e){}
try{document.addEventListener(`visibilitychange`,function(){document.hidden&&auto()})}catch(e){}
window.__sessions__={list:list,load:open,save:function(){return save(M.getState().messages)},delete:del,remove:del,rename:rename,current:getCur};
})();
